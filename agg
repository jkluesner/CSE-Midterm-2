import pandas as pd
import numpy as np

# Sample DataFrame
df = pd.DataFrame({
    'user': ['A', 'A', 'A', 'B', 'B', 'C'],
    'price': [10, 20, 30, 40, 50, 60],
    'reviews': [1, 2, 3, 4, 5, 6],
    'name': ['x', 'x', 'x', 'y', 'y', 'z'],
    'item': ['apple', 'banana', 'apple', 'banana', 'banana', 'apple']
})

# 1. Basic aggregations
df.groupby('user').agg({'price': 'mean'})
# Output:
#        price
# user
# A       20.0
# B       45.0
# C       60.0

# 2. Multiple aggregations on different columns
df.groupby('user').agg({
    'price': 'mean',
    'reviews': 'sum'
})
# Output:
#        price  reviews
# user
# A       20.0        6
# B       45.0        9
# C       60.0        6

# 3. Multiple aggregations on same column
df.groupby('user').agg({
    'price': ['min', 'max', 'mean']
})
# Output:
#       price
#        min max mean
# user
# A       10  30  20.0
# B       40  50  45.0
# C       60  60  60.0

# 4. Custom column names
df.groupby('user').agg(
    avg_price=('price', 'mean'),
    total_reviews=('reviews', 'sum')
)
# Output:
#        avg_price  total_reviews
# user
# A           20.0              6
# B           45.0              9
# C           60.0              6

# 5. String aggregations
df.groupby('user').agg({
    'name': 'first'
})
# Output:
#       name
# user
# A        x
# B        y
# C        z

# 6. Count unique values
df.groupby('user').agg({
    'item': 'nunique'
})
# Output:
#       item
# user
# A        2
# B        1
# C        1

# 7. Collect values into list
df.groupby('user').agg({
    'item': list
})
# Output:
#       item
# user
# A  [apple, banana, apple]
# B  [banana, banana]
# C  [apple]

# 8. Most frequent value (mode)
df.groupby('user').agg({
    'item': lambda x: x.mode()[0]
})
# Output:
#       item
# user
# A    apple
# B   banana
# C    apple

# 9. Custom function (range)
df.groupby('user').agg({
    'price': lambda x: x.max() - x.min()
})
# Output:
#       price
# user
# A        20
# B        10
# C         0

# 10. Using NumPy functions
df.groupby('user').agg({
    'price': np.mean,
    'reviews': np.sum
})
# Output:
#        price  reviews
# user
# A       20.0        6
# B       45.0        9
# C       60.0        6
