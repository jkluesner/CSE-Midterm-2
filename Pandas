import pandas as pd
import numpy as np
from pandas.testing import assert_frame_equal

############################################################
# ✅ 1. CANONICALIZE A DATAFRAME (MOST IMPORTANT)
############################################################
def canonicalize_tibble(X):
    cols = sorted(X.columns)
    return X[cols].sort_values(by=cols).reset_index(drop=True)

############################################################
# ✅ 2. ADD COMPUTED COLUMN (VECTORIZE!)
############################################################
def calc_prevalence(G):
    assert 'cases' in G.columns and 'population' in G.columns
    G = G.copy()
    
    # FAST (preferred)
    G['prevalence'] = G['cases'] / G['population']
    
    # SLOW (avoid if possible)
    # G['prevalence'] = G.apply(lambda row: row['cases']/row['population'], axis=1)
    
    return G

############################################################
# ✅ 3. CHECK IF TWO DATAFRAMES ARE EQUIVALENT
############################################################
def tibbles_are_equivalent(A, B):
    try:
        A = canonicalize_tibble(A)
        B = canonicalize_tibble(B)
        assert_frame_equal(A, B)
        return 'Tibbles are equivalent!'
    except AssertionError as e:
        return str(e)

############################################################
# ✅ 4. MELT (WIDE → LONG)
############################################################
def melt(df, col_vals, key, value):
    assert type(df) is pd.DataFrame
    
    keep = df.columns.difference(col_vals)
    
    result = pd.concat([
        df[keep].assign(**{
            key: c,
            value: df[c]
        })
        for c in col_vals
    ])
    
    return result

############################################################
# ✅ 5. SEPARATE (SPLIT COLUMN INTO MULTIPLE)
############################################################
def default_splitter(text):
    import re
    return re.findall(r'(\d+\.?\d+)', text)

def separate(df, key, into, splitter=default_splitter):
    assert type(df) is pd.DataFrame
    assert key in df.columns
    
    def apply_splitter(text):
        fields = splitter(text)
        return pd.Series({into[i]: f for i, f in enumerate(fields)})
    
    df_extra = df[key].apply(apply_splitter)
    result = pd.concat([df.drop(columns=[key]), df_extra], axis=1)
    
    return result

