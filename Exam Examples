def calc_time_left_apply(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    def time_left(row):
        # convert MM:SS to seconds
        mins, secs = map(int, row['clock'].split(':'))
        clock_seconds = mins * 60 + secs       
        # add remaining quarters
        remaining_quarters = (4 - row['period']) * 15 * 60       
        return remaining_quarters + clock_seconds
    # apply row-wise
    df['timeLeft'] = df.apply(time_left, axis=1)
    return df


