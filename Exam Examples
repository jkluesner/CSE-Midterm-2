## OR ##
    return event_df.groupby('drive_id', as_index=False).apply(converted_by_drive).reset_index(drop=True)


def who_won(event_df: pd.DataFrame) -> pd.DataFrame:
    # Sort so last row represents final game state
    df = event_df.sort_values('timeLeft', ascending=False).copy()  
    # Get final row (keeps labels — clearer than .values)
    last_row = df.iloc[-1]  
    # Determine if home team won
    home_won = last_row['awayScore'] < last_row['homeScore']  
    # Mark whether the team in possession is the winner
    df['won'] = df['homeTeamPoss'] == home_won
    return df
