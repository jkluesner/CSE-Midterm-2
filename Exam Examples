def decision_model(df: pd.DataFrame):
    
    # Complement probabilities
    fg_miss = 1 - df['fg_make_prob']
    go_fail = 1 - df['go_succeed_prob']
    
    # Expected value formula:
    # P(A)*value(A) + P(B)*value(B)
    
    df['kick_wp'] = (
        df['fg_make_prob'] * df['fg_make_wp'] +
        fg_miss * df['fg_miss_wp']
    )
    
    df['go_wp'] = (
        df['go_succeed_prob'] * df['succeed_wp'] +
        go_fail * df['fail_wp']
    )
    
