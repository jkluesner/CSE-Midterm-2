def who_won(df: pd.DataFrame) -> pd.DataFrame:
    
    df = df.sort_values('timeLeft', ascending=False).copy()
    
    # iloc[-1] → last row
    last = df.iloc[-1]
    
    # Compare final scores
    home_won = last['homeScore'] > last['awayScore']
    
    # == → elementwise comparison
    # True if possession team == winning team
    df['won'] = df['homeTeamPoss'] == home_won
    
    return df


