    not_punt = ~df['type'].str.contains('punt', case=False)
    
    # isin → check membership
    third_fourth = df['down'].isin([3, 4])
    
    mask = not_fga & not_punt & third_fourth
    
    # .loc[rows, columns]
    conversion = df.loc[mask, ['event_id','play_id','down','distance','converted']]
    ep = df[['event_id','play_id','down','distance','yardsToEndzone','nextScore']]
    win_prob = df[['event_id','play_id','down','distance','yardsToEndzone',
                   'timeLeft','awayScore','homeScore','homeTeamPoss','won']]
    
    return conversion, ep, win_prob


