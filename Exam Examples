# ==================================================
# 1. TIME LEFT (STRING → NUMERIC, VECTORIZED)
# ==================================================
def calc_time_left(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()  # avoid modifying original
    
    # Split "MM:SS" into two columns
    # expand=True → returns DataFrame (NOT list)
    time_parts = df['clock'].str.split(':', expand=True).astype(int)
    
    minutes = time_parts[0]
    seconds = time_parts[1]
    
    # (4 - period) → quarters remaining
    # * 900 → seconds per quarter
    # + current clock time
    df['timeLeft'] = (4 - df['period']) * 900 + minutes * 60 + seconds
    
    return df


# ==================================================
# 2. BOOLEAN FILTERING (CORE PANDAS SKILL)
# ==================================================
def filter_non_plays_and_ot(df: pd.DataFrame) -> pd.DataFrame:
    
    # isin(list) → True if value is in list
    # ~ → NOT (invert True/False)
    plays = ~df['type'].isin(['Penalty', 'Timeout'])
    
    # Find events that go into overtime
    ot_events = df.loc[df['timeLeft'] < 0, 'event_id'].unique()
    
    # isin again → check membership
    ends_in_reg = ~df['event_id'].isin(ot_events)
    
    # & → AND (both conditions must be True)
    return df.loc[plays & ends_in_reg]


# ==================================================
# 3. GROUPBY + SHIFT (LAG FEATURES)
# ==================================================
def lag_score(df: pd.DataFrame) -> pd.DataFrame:
    
    # Must sort BEFORE shift (order matters)
    df = df.sort_values(['event_id', 'timeLeft'], ascending=[True, False]).copy()
    
    # groupby('event_id') → split into groups
    # [['homeScore','awayScore']] → select columns
    # shift(1) → move values DOWN by 1 row
    # fill_value=0 → first row becomes 0
    
    df[['homeScore', 'awayScore']] = (
        df.groupby('event_id')[['homeScore', 'awayScore']]
          .shift(1, fill_value=0)
    )
    
    return df


# ==================================================
# 4. NEXT SCORE (WHERE + BFILL = REPLACE LOOPS)
# ==================================================
def add_next_score(df: pd.DataFrame) -> pd.DataFrame:
    
    df = df.sort_values('timeLeft', ascending=False).copy()
    
    # diff() → change from previous row
    # ne(0) → not equal to 0 (True if change happened)
    # any(axis=1) → True if ANY column changed
    score_change = df[['homeScore', 'awayScore']].diff().ne(0).any(axis=1)
    
    # Score difference (home perspective)
    score_diff = df['homeScore'] - df['awayScore']
    
    # where(condition):
    # keep value IF condition True
    # else → NaN
    temp = score_diff.where(score_change)
    
    # bfill():
    # fill NaN with NEXT valid value (looking downward)
    df['nextScore'] = temp.bfill()
    
    # Flip sign if away team has possession
    # ~ → NOT (homeTeamPoss False → away team)
    df.loc[~df['homeTeamPoss'], 'nextScore'] *= -1
    
    return df


