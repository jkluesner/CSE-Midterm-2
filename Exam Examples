# 7. CONDITIONAL LOGIC (NP.WHERE)
# ==================================================
def win_prob_model(df: pd.DataFrame) -> np.ndarray:
    
    offense_ep = ep_model(df)  # expected points
    
    # np.where(condition, if_true, if_false)
    mu = np.where(
        df['homeTeamPoss'],
        offense_ep + df['homeScore'] - df['awayScore'],
        offense_ep + df['awayScore'] - df['homeScore']
    )
    
    # sigma = uncertainty
    # decreases as time decreases
    sigma = 13.85 / np.sqrt(3600 / (1 + df['timeLeft']))
    
    # norm.cdf(x, loc, scale):
    # probability value ≤ x
    return 1 - norm.cdf(0.5, loc=mu, scale=sigma)


