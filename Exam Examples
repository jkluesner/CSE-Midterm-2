def who_won(event_df: pd.DataFrame) -> pd.DataFrame:
    # Sort so last row represents final game state
    df = event_df.sort_values('timeLeft', ascending=False).copy()  
    # Get final row (keeps labels — clearer than .values)
    last_row = df.iloc[-1]  
    # Determine if home team won
    home_won = last_row['awayScore'] < last_row['homeScore']  
    # Mark whether the team in possession is the winner
    df['won'] = df['homeTeamPoss'] == home_won
    return df


def add_next_score(df: pd.DataFrame) -> pd.DataFrame:
    df = df.sort_values('timeLeft', ascending=False).copy()   
    # Identify rows where score changes
    score_change = (df['homeScore'].diff().fillna(0) != 0) | \
                   (df['awayScore'].diff().fillna(0) != 0)  
    # Compute score difference change (you may adjust based on your logic)
    df['score_diff'] = df['homeScore'] - df['awayScore']
    # Only keep score_diff at scoring moments
    df['nextScore'] = df['score_diff'].where(score_change)  
    # Backfill → propagate next score backward
    df['nextScore'] = df['nextScore'].bfill()
    # Flip sign for away possession
    df.loc[~df['homeTeamPoss'], 'nextScore'] *= -1
    return df.drop(columns='score_diff')
